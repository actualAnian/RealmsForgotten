<Prefab>
  <Constants/>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- Only attributes proven in HomesteadEditorHUD.xml are used here:
             Frame1Brush / RenderLate / CoverChildren / alignments / margins /
             ListPanel StackLayout / TextWidget Brush.FontSize / Text binding. -->
        <BrushWidget Brush="Frame1Brush" RenderLate="true"
                     WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                     HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="150">
          <Children>
            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       StackLayout.LayoutMethod="VerticalTopToBottom"
                       MarginTop="18" MarginBottom="18" MarginLeft="50" MarginRight="50">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Brush.FontSize="36" Brush.TextHorizontalAlignment="Center"
                            Text="@BannerText" />
              </Children>
            </ListPanel>
          </Children>
        </BrushWidget>

      </Children>
    </Widget>
  </Window>
</Prefab>
