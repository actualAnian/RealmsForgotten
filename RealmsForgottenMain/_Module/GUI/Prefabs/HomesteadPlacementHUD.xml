<Prefab>
  <Window>
    <!-- We intercept left-click on the map to place the homestead. -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true">
      <Children>
        <BrushWidget Brush="Frame1Brush" RenderLate="true"
                     WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                     HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="100" IsVisible="@IsVisible">
          <Children>
            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       StackLayout.LayoutMethod="VerticalTopToBottom"
                       MarginTop="15" MarginBottom="15" MarginLeft="25" MarginRight="25">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" MarginBottom="10" Text="@PlacementControlsText" Brush="SPOptions.Description.Text" Brush.FontSize="20" Brush.FontColor="#FFCC00FF"/>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" Text="@EstimatedTravelTimeText" Brush="SPOptions.Description.Text" Brush.FontSize="24" Brush.FontColor="#FFFFFFFF"/>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" MarginTop="5" Text="@PlacementWarningText" Brush="SPOptions.Description.Text" Brush.FontSize="16" Brush.FontColor="#FF8888FF"/>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" MarginTop="5" Text="@PlacementHaltedText" Brush="SPOptions.Description.Text" Brush.FontSize="16" Brush.FontColor="#FF8888FF"/>
              </Children>
            </ListPanel>
          </Children>
        </BrushWidget>
      </Children>
    </Widget>
  </Window>
</Prefab>