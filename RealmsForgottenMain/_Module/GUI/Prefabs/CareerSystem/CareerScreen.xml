														</ListPanel>
														<!--Frame Border-->
														<BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="Popup.Frame" IsEnabled="false" />
													</Children>
												</Widget>
												<!-- perk info -->

												<Widget DataSource="{TopScreen}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" HorizontalAlignment="Center">
													<Children>
														<ImageWidget SuggestedWidth="750" SuggestedHeight="320" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" VerticalAlignment="Center" MarginTop="5" Sprite="StdAssets\Popup\canvas">
															<Children>
																<TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="100" SuggestedWidth="500" HorizontalAlignment="Center" Text="@GroupName" Brush="TorCareerChoiceBrush" PositionYOffset="-20"/>
