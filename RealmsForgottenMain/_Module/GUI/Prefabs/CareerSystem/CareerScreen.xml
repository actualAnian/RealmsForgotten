				<!--Triple Dialog Buttons-->
				<Standard.TripleDialogCloseButtons VisualDefinition="BottomMenu" HorizontalAlignment="Center" VerticalAlignment="Bottom" PositionYOffset="100" Parameter.CancelButtonAction="ExecuteCancel" Parameter.CancelButtonText="Cancel"  Parameter.DoneButtonAction="ExecuteDone" Parameter.DoneButtonText="Done" Parameter.ResetButtonAction="ExecuteReset" Parameter.ResetInputKeyDataSource="{ResetInputKey}" />
			</Children>
