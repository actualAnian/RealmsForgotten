<prefabs>
  <!-- Race Gate (waypoint) marker.  Place several around the loop to define the path and validate
       progress.  Invisible during play, shown yellow while editing.  The race mission reads their
       world positions by prefab name and orders them into the lap. -->
  <game_entity name="homestead_race_gate" old_prefab_name="">
    <transform position="0.000, 0.000, 0.000" rotation_euler="0.000, 0.000, 0.000" scale="1.000, 1.000, 1.000"/>
    <components>
      <meta_mesh_component name="flag_pole_big"/>
    </components>
    <children>
      <game_entity name="homestead_race_gate_cloth" old_prefab_name="">
        <transform position="0.000, 0.290, 3.576" rotation_euler="0.000, 0.000, 3.141" scale="1.322, 1.322, 1.322"/>
        <components>
          <meta_mesh_component name="flag_stand_cloth"/>
        </components>
      </game_entity>
    </children>
  </game_entity>
</prefabs>
