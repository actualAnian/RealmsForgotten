<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>0.0.1</Version>
        <TargetFramework>net472</TargetFramework>
        <Platforms>x64</Platforms>
        <LangVersion>10.0</LangVersion>
        <Nullable>enable</Nullable>
        <BuildForWindows>True</BuildForWindows>
        <BuildForWindowsStore>True</BuildForWindowsStore>
        <ModuleId>$(MSBuildProjectName)</ModuleId>
        <ModuleName>$(MSBuildProjectName)</ModuleName>
        <GameFolder>$(BANNERLORD_GAME_DIR)</GameFolder>
        <ModuleRoot>$(GameFolder)\Modules\RealmsForgotten</ModuleRoot>
        <ModuleBin>$(ModuleRoot)\bin\Win64_Shipping_Client</ModuleBin>
        <LocalModuleBin>_Module\bin\Win64_Shipping_Client</LocalModuleBin>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
      <Optimize>False</Optimize>
      <DebugType>portable</DebugType>
      <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
      <Optimize>False</Optimize>
      <DebugType>portable</DebugType>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="$(GameFolder)\Modules\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll">
	        <HintPath>%(Identity)</HintPath>
	        <Private>False</Private>
        </Reference>
	  
        <Reference Include="$(GameFolder)\bin\Win64_Shipping_Client\Newtonsoft.Json.dll">
	        <HintPath>%(Identity)</HintPath>
	        <Private>False</Private>
        </Reference>
	  
        <Reference Include="Bannerlord.BLSE.Shared">
          <HintPath>..\..\..\..\..\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord\bin\Win64_Shipping_Client\Bannerlord.BLSE.Shared.dll</HintPath>
        </Reference>
	  
        <Reference Include="Bannerlord.UIExtenderEx">
        <HintPath>..\..\..\..\..\..\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord\Modules\Bannerlord.UIExtenderEx\bin\Win64_Shipping_Client\Bannerlord.UIExtenderEx.dll</HintPath>
        </Reference>
	  
        <Reference Include="BehaviorTrees">
        <HintPath>_Module\bin\Win64_Shipping_Client\BehaviorTrees.dll</HintPath>
        </Reference>
	  
        <Reference Include="BehaviorTreeWrapper">
        <HintPath>_Module\bin\Win64_Shipping_Client\BehaviorTreeWrapper.dll</HintPath>
        </Reference>
	  
        <Reference Include="C:\Program Files %28x86%29\Steam\steamapps\common\Mount &amp; Blade II Bannerlord\bin\Win64_Shipping_Client\TaleWorlds.TwoDimension.Standalone.dll">
          <HintPath>C:\Program Files %28x86%29\Steam\steamapps\common\Mount &amp; Blade II Bannerlord\bin\Win64_Shipping_Client\TaleWorlds.TwoDimension.Standalone.dll</HintPath>
          <Private>False</Private>
        </Reference>

		<Reference Include="$(GameFolder)\bin\Win64_Shipping_Client\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>		
        <Reference Include="$(GameFolder)\Modules\Native\bin\Win64_Shipping_Client\*.dll">
            <HintPath>%(Identity)</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="$(GameFolder)\Modules\SandBoxCore\bin\Win64_Shipping_Client\*.dll">
            <HintPath>%(Identity)</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="$(GameFolder)\Modules\CustomBattle\bin\Win64_Shipping_Client\*.dll">
            <HintPath>%(Identity)</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="$(GameFolder)\Modules\BirthAndDeath\bin\Win64_Shipping_Client\*.dll">
            <HintPath>%(Identity)</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="$(GameFolder)\Modules\StoryMode\bin\Win64_Shipping_Client\*.dll">
	        <HintPath>%(Identity)</HintPath>
	        <Private>False</Private>
        </Reference>
		<Reference Include="$(GameFolder)\Modules\SandBox\bin\Win64_Shipping_Client\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(GameFolder)\Modules\NavalDLC\bin\Win64_Shipping_Client\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Bannerlord.UIExtenderEx" Version="2.13.2" />
        <PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
        <PackageReference Include="IsExternalInit" Version="1.0.3" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
        <PackageReference Include="Bannerlord.BuildResources" Version="1.1.0.129" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
        <PackageReference Include="Lib.Harmony" Version="2.4.2" IncludeAssets="compile" />
        <PackageReference Include="Harmony.Extensions" Version="3.2.0.77" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
        <PackageReference Include="BUTR.Harmony.Analyzer" Version="1.0.1.50" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
	    <PackageReference Include="DynamicExpresso.Core" PrivateAssets="all" Version="2.19.3" />
    </ItemGroup>
    <ItemGroup>
        <Folder Include="AiMade\TroopUnlocker\" />
        <Folder Include="_Module\GUI\Prefabs\CharacterDeveloper\" />
        <Folder Include="_Module\ModuleSounds\" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\RF_BattleAI\RF_BattleAI.csproj" />
      <ProjectReference Include="..\RF_Promoted\RF_Promoted.csproj" />
      <ProjectReference Include="..\RF_warsystem\RF_warsystem.csproj" />
    </ItemGroup>
    <ItemGroup>
      <None Include="_Module\ModuleData\project.mbproj" />
    </ItemGroup>
    <ItemGroup>
      <RFArmyCommandAsset Include="_Module\SubModule.xml">
        <ModuleRelativePath>SubModule.xml</ModuleRelativePath>
      </RFArmyCommandAsset>
      <RFArmyCommandAsset Include="_Module\GUI\Prefabs\Map\RFArmyOverlayWindow.xml">
        <ModuleRelativePath>GUI\Prefabs\Map\RFArmyOverlayWindow.xml</ModuleRelativePath>
      </RFArmyCommandAsset>
      <RFArmyCommandAsset Include="_Module\GUI\Prefabs\Extensions\RFArmyManagementWidgets.xml">
        <ModuleRelativePath>GUI\Prefabs\Extensions\RFArmyManagementWidgets.xml</ModuleRelativePath>
      </RFArmyCommandAsset>
      <RFArmyCommandAsset Include="_Module\GUI\Brushes\ArmyCommanderBrushes.xml">
        <ModuleRelativePath>GUI\Brushes\ArmyCommanderBrushes.xml</ModuleRelativePath>
      </RFArmyCommandAsset>
      <RFArmyCommandAsset Include="_Module\ModuleData\rfitems\rf_magic_accessory_items.xml">
        <ModuleRelativePath>ModuleData\rfitems\rf_magic_accessory_items.xml</ModuleRelativePath>
      </RFArmyCommandAsset>
      <RFArmyCommandAsset Include="_Module\ModuleData\rfitems\rf_dual_wield_items.xml">
        <ModuleRelativePath>ModuleData\rfitems\rf_dual_wield_items.xml</ModuleRelativePath>
      </RFArmyCommandAsset>
      <RFArmyCommandAsset Include="_Module\ModuleData\project.mbproj">
        <ModuleRelativePath>ModuleData\project.mbproj</ModuleRelativePath>
      </RFArmyCommandAsset>
      <RFArmyCommandAsset Include="_Module\ModuleData\action_sets.xml">
        <ModuleRelativePath>ModuleData\action_sets.xml</ModuleRelativePath>
      </RFArmyCommandAsset>
      <RFArmyCommandAsset Include="_Module\ModuleData\action_sets.xslt">
        <ModuleRelativePath>ModuleData\action_sets.xslt</ModuleRelativePath>
      </RFArmyCommandAsset>
      <RFArmyCommandAsset Include="_Module\ModuleData\action_types.xml">
        <ModuleRelativePath>ModuleData\action_types.xml</ModuleRelativePath>
      </RFArmyCommandAsset>
      <RFArmyCommandAsset Include="_Module\ModuleData\combat_parameters.xml">
        <ModuleRelativePath>ModuleData\combat_parameters.xml</ModuleRelativePath>
      </RFArmyCommandAsset>
      <RFArmyCommandAsset Include="_Module\ModuleData\item_holsters.xml">
        <ModuleRelativePath>ModuleData\item_holsters.xml</ModuleRelativePath>
      </RFArmyCommandAsset>
      <RFArmyCommandAsset Include="_Module\ModuleData\item_usage_sets.xml">
        <ModuleRelativePath>ModuleData\item_usage_sets.xml</ModuleRelativePath>
      </RFArmyCommandAsset>
      <RFArmyCommandAsset Include="_Module\ModuleData\item_usage_sets.xslt">
        <ModuleRelativePath>ModuleData\item_usage_sets.xslt</ModuleRelativePath>
      </RFArmyCommandAsset>
      <RFArmyCommandAsset Include="_Module\ModuleData\movement_sets.xml">
        <ModuleRelativePath>ModuleData\movement_sets.xml</ModuleRelativePath>
      </RFArmyCommandAsset>
      <RFArmyCommandAsset Include="_Module\ModuleData\full_movement_sets.xml">
        <ModuleRelativePath>ModuleData\full_movement_sets.xml</ModuleRelativePath>
      </RFArmyCommandAsset>
      <RFArmyCommandAsset Include="_Module\Assets\*.tpac">
        <ModuleRelativePath>Assets\%(Filename)%(Extension)</ModuleRelativePath>
      </RFArmyCommandAsset>
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="Build">
      <MakeDir Directories="$(LocalModuleBin)" />
      <Copy SourceFiles="$(TargetPath)"
            DestinationFolder="$(LocalModuleBin)"
            SkipUnchangedFiles="true" />
      <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
            DestinationFolder="$(LocalModuleBin)"
            SkipUnchangedFiles="true"
            Condition="Exists('$(TargetDir)$(TargetName).pdb')" />

      <MakeDir Directories="$(ModuleBin)" Condition="'$(GameFolder)' != '' and '$(DisableModuleCopy)' != 'true'" />
      <Copy SourceFiles="$(TargetPath)"
            DestinationFolder="$(ModuleBin)"
            SkipUnchangedFiles="true"
            Condition="'$(GameFolder)' != '' and '$(DisableModuleCopy)' != 'true'" />
      <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
            DestinationFolder="$(ModuleBin)"
            SkipUnchangedFiles="true"
            Condition="'$(GameFolder)' != '' and '$(DisableModuleCopy)' != 'true' and Exists('$(TargetDir)$(TargetName).pdb')" />

      <Copy SourceFiles="@(RFArmyCommandAsset)"
            DestinationFiles="@(RFArmyCommandAsset->'$(ModuleRoot)\%(ModuleRelativePath)')"
            SkipUnchangedFiles="true"
            Condition="'$(GameFolder)' != '' and '$(DisableModuleCopy)' != 'true'" />
    </Target>
</Project>
