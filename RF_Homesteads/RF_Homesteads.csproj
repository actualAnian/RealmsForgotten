<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Platforms>x64</Platforms>
    <LangVersion>12.0</LangVersion>
    <!-- Decompiled source (Homesteads Reloaded v1.2.14) — not nullable-annotated. -->
    <Nullable>disable</Nullable>
    <!-- Keep the ORIGINAL assembly name + namespaces: the save system definer
         (CustomSaveDefiner, base 321601531) and behavior StringIds must match
         existing Homesteads saves. Only the project/folder is RF_-prefixed. -->
    <AssemblyName>HomesteadsReloaded</AssemblyName>
    <RootNamespace>Homesteads</RootNamespace>
    <GameFolder>$(BANNERLORD_GAME_DIR)</GameFolder>
    <ModuleRoot>$(GameFolder)\Modules\RealmsForgotten</ModuleRoot>
    <ModuleBin>$(ModuleRoot)\bin\Win64_Shipping_Client</ModuleBin>
    <LocalModuleRoot>..\RealmsForgottenMain\_Module</LocalModuleRoot>
    <LocalModuleBin>$(LocalModuleRoot)\bin\Win64_Shipping_Client</LocalModuleBin>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Optimize>False</Optimize>
    <DebugType>portable</DebugType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Optimize>False</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(GameFolder)\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\Native\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\SandBoxCore\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\CustomBattle\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\SandBox\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\StoryMode\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.2.2" IncludeAssets="compile" />
    <PackageReference Include="Bannerlord.UIExtenderEx" Version="2.13.2" IncludeAssets="compile" />
    <PackageReference Include="Bannerlord.ButterLib" Version="2.8.11" IncludeAssets="compile" />
    <PackageReference Include="Bannerlord.MCM" Version="5.9.1" IncludeAssets="compile" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build">
    <MakeDir Directories="$(LocalModuleBin)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LocalModuleBin)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(LocalModuleBin)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />

    <MakeDir Directories="$(ModuleBin)" Condition="'$(GameFolder)' != ''" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModuleBin)" SkipUnchangedFiles="true" Condition="'$(GameFolder)' != ''" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModuleBin)" SkipUnchangedFiles="true" Condition="'$(GameFolder)' != '' and Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

</Project>
