<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Platforms>x64</Platforms>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>RF_CoopCompat</AssemblyName>
    <RootNamespace>RF_CoopCompat</RootNamespace>
    <GameFolder>$(BANNERLORD_GAME_DIR)</GameFolder>
    <ModuleRoot>$(GameFolder)\Modules\RF_CoopCompat</ModuleRoot>
    <ModuleBin>$(ModuleRoot)\bin\Win64_Shipping_Client</ModuleBin>
    <LocalModuleRoot>_Module</LocalModuleRoot>
    <LocalModuleBin>$(LocalModuleRoot)\bin\Win64_Shipping_Client</LocalModuleBin>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Optimize>False</Optimize>
    <DebugType>portable</DebugType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Optimize>False</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(GameFolder)\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\Native\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\SandBoxCore\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\SandBox\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="_Module\SubModule.xml" />
    <None Include="_Module\rf_coop_compat.cfg" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build" Condition="'$(GameFolder)' != ''">
    <MakeDir Directories="$(ModuleBin)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(ModuleBin)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(ModuleBin)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="_Module\SubModule.xml"
          DestinationFolder="$(ModuleRoot)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="_Module\rf_coop_compat.cfg"
          DestinationFolder="$(ModuleRoot)"
          Condition="!Exists('$(ModuleRoot)\rf_coop_compat.cfg')" />
  </Target>

</Project>
