<!-- Map-icon prefabs for settler villages (RF_Settlers phase C).
     One entry per base culture using that culture's vanilla village meshes
     (village_<culture>_1/2/3); the engine's level mask shows level_1 while
     hearth < 200, level_2 < 600, level_3 above — so a new settler village
     starts small and grows with its hearth, like any other village.
     For RF custom cultures add a "rf_settler_village_icon_<culture_id>"
     entry with that culture's meshes — the code tries the culture variant
     first and falls back to the generic (empire) icon.
     Deploy into Modules/RealmsForgotten/Prefabs/. -->
<prefabs>
	<game_entity name="rf_settler_village_icon" mobility="1" template_type="Village">
		<tags>
			<tag name="village" />
		</tags>
		<transform position="0.000, 0.000, 0.000" rotation_euler="0.000, 0.000, 0.000" scale="1.000, 1.000, 1.000" />
		<scripts>
			<script name="Town Entity Manager">
				<variables>
					<variable name="Override Factor Color" value="false" />
					<variable name="Factor Color" value="1.000, 1.000, 1.000, 1.000" />
				</variables>
			</script>
		</scripts>
		<children>
		<game_entity name="rf_settler_village_icon_l1" mobility="1">
			<transform position="0.000, 0.000, 0.000" rotation_euler="0.000, 0.000, 0.000" scale="0.400, 0.400, 0.400" />
			<components>
				<meta_mesh_component name="village_empire_1" />
			</components>
			<levels>
				<level name="level_1" />
				<level name="civilian" />
				<level name="siege" />
