<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>0.0.1</Version>
        <TargetFramework>net472</TargetFramework>
        <Platforms>x64</Platforms>
        <LangVersion>10.0</LangVersion>
        <Nullable>disable</Nullable>
        <AssemblyName>RF_PartyVisuals</AssemblyName>
        <RootNamespace>RF_PartyVisuals</RootNamespace>
        <Configurations>Debug;Release</Configurations>
        <GameFolder>$(BANNERLORD_GAME_DIR)</GameFolder>
        <ModuleRoot>$(GameFolder)\Modules\RealmsForgotten</ModuleRoot>
        <ModuleBin>$(ModuleRoot)\bin\Win64_Shipping_Client</ModuleBin>
        <LocalModuleBin>..\RealmsForgottenMain\_Module\bin\Win64_Shipping_Client</LocalModuleBin>
    </PropertyGroup>

    <!--
      Clean-room RF-native replacement for ArtemsBetterPartyVisuals: 3D troop figures on
      every campaign-map party icon, plus themed restyling for RF living-world parties.
      Built from a study of the technique, NOT copied from the decompiled mod.

      2026-08-18: deixou de ser modulo stand-alone e passou a compilar para dentro do
      modulo RealmsForgotten, como RF_Ambush / RF_AliveScenes. O SubModule fica
      registrado em RealmsForgottenMain/_Module/SubModule.xml e os action_sets dos
      animais foram para o action_sets.xml do RF. A pasta Modules/RF_PartyVisuals antiga
      continua no disco de proposito — NAO deixe as duas ligadas no launcher ao mesmo
      tempo (o SubModule tem guarda estatica, mas o modulo antigo carrega uma DLL velha).
    -->

    <ItemGroup>
        <!-- Core engine assemblies. -->
        <Reference Include="$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.*.dll">
            <HintPath>%(Identity)</HintPath>
            <Private>False</Private>
        </Reference>
        <!-- View layer (AgentVisuals, MissionView, MobilePartyVisual base) lives under Native. -->
        <Reference Include="$(GameFolder)\Modules\Native\bin\Win64_Shipping_Client\*.dll">
            <HintPath>%(Identity)</HintPath>
            <Private>False</Private>
        </Reference>
        <!-- SandBox map visuals (MobilePartyVisual, MobilePartyVisualManager). -->
        <Reference Include="$(GameFolder)\Modules\SandBox\bin\Win64_Shipping_Client\SandBox.dll">
            <HintPath>%(Identity)</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="$(GameFolder)\Modules\SandBox\bin\Win64_Shipping_Client\SandBox.View.dll">
            <HintPath>%(Identity)</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="$(GameFolder)\Modules\SandBoxCore\bin\Win64_Shipping_Client\SandBoxCore.dll">
            <HintPath>%(Identity)</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="$(GameFolder)\Modules\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll">
            <HintPath>%(Identity)</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Bannerlord.MCM" Version="5.9.1" IncludeAssets="compile" />
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="Build">
        <MakeDir Directories="$(LocalModuleBin)" />
        <Copy SourceFiles="$(TargetPath)"
              DestinationFolder="$(LocalModuleBin)"
              SkipUnchangedFiles="true" />
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
              DestinationFolder="$(LocalModuleBin)"
              SkipUnchangedFiles="true"
              Condition="Exists('$(TargetDir)$(TargetName).pdb')" />

        <MakeDir Directories="$(ModuleBin)" Condition="'$(GameFolder)' != ''" />
        <Copy SourceFiles="$(TargetPath)"
              DestinationFolder="$(ModuleBin)"
              SkipUnchangedFiles="true"
              Condition="'$(GameFolder)' != ''" />
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
              DestinationFolder="$(ModuleBin)"
              SkipUnchangedFiles="true"
              Condition="'$(GameFolder)' != '' and Exists('$(TargetDir)$(TargetName).pdb')" />
    </Target>

</Project>
