<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Platforms>x64</Platforms>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>RF_LivingWorld</AssemblyName>
    <RootNamespace>RF_LivingWorld</RootNamespace>
    <GameFolder>$(BANNERLORD_GAME_DIR)</GameFolder>
    <ModuleRoot>$(GameFolder)\Modules\RealmsForgotten</ModuleRoot>
    <ModuleBin>$(ModuleRoot)\bin\Win64_Shipping_Client</ModuleBin>
    <LocalModuleBin>..\RealmsForgottenMain\_Module\bin\Win64_Shipping_Client</LocalModuleBin>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Optimize>False</Optimize>
    <DebugType>portable</DebugType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Optimize>False</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RF_Settlers\RF_Settlers.csproj"><Private>False</Private></ProjectReference>
    <ProjectReference Include="..\RealmsForgottenMain\RealmsForgotten.csproj"><Private>False</Private></ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameFolder)\bin\Win64_Shipping_Client\*.dll"><HintPath>%(Identity)</HintPath><Private>False</Private></Reference>
    <Reference Include="$(GameFolder)\Modules\Native\bin\Win64_Shipping_Client\*.dll"><HintPath>%(Identity)</HintPath><Private>False</Private></Reference>
    <Reference Include="$(GameFolder)\Modules\SandBoxCore\bin\Win64_Shipping_Client\*.dll"><HintPath>%(Identity)</HintPath><Private>False</Private></Reference>
    <Reference Include="$(GameFolder)\Modules\CustomBattle\bin\Win64_Shipping_Client\*.dll"><HintPath>%(Identity)</HintPath><Private>False</Private></Reference>
    <Reference Include="$(GameFolder)\Modules\SandBox\bin\Win64_Shipping_Client\*.dll"><HintPath>%(Identity)</HintPath><Private>False</Private></Reference>
    <Reference Include="$(GameFolder)\Modules\StoryMode\bin\Win64_Shipping_Client\*.dll"><HintPath>%(Identity)</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <LivingWorldAsset Include="..\RealmsForgottenMain\_Module\ModuleData\living_world_parties.xml"><ModuleRelativePath>ModuleData\living_world_parties.xml</ModuleRelativePath></LivingWorldAsset>
    <!-- living_world_action_sets.xml removido do repo em 7b45dbc: os action sets
         dos rebanhos ganharam definicao completa em ModuleData\action_sets.xml -->
    <LivingWorldAsset Include="..\RealmsForgottenMain\_Module\ModuleData\project.mbproj"><ModuleRelativePath>ModuleData\project.mbproj</ModuleRelativePath></LivingWorldAsset>
    <LivingWorldAsset Include="..\RealmsForgottenMain\_Module\ModuleData\Languages\language_data.xml"><ModuleRelativePath>ModuleData\Languages\language_data.xml</ModuleRelativePath></LivingWorldAsset>
    <LivingWorldAsset Include="..\RealmsForgottenMain\_Module\ModuleData\Languages\str_living_world.xml"><ModuleRelativePath>ModuleData\Languages\str_living_world.xml</ModuleRelativePath></LivingWorldAsset>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build" Condition="'$(DisableModuleCopy)' != 'true'">
    <MakeDir Directories="$(LocalModuleBin)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LocalModuleBin)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(LocalModuleBin)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <MakeDir Directories="$(ModuleBin)" Condition="'$(GameFolder)' != ''" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModuleBin)" SkipUnchangedFiles="true" Condition="'$(GameFolder)' != ''" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModuleBin)" SkipUnchangedFiles="true" Condition="'$(GameFolder)' != '' and Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="@(LivingWorldAsset)" DestinationFiles="@(LivingWorldAsset->'$(ModuleRoot)\%(ModuleRelativePath)')" SkipUnchangedFiles="true" Condition="'$(GameFolder)' != ''" />
  </Target>
</Project>
