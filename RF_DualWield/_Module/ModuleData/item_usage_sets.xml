<?xml version="1.0" encoding="utf-8"?>
<!--
  RF_DualWield / item_usage_sets.xml

  DEFESA UP (corrigida na rodada 5) - por que estas 3 usages existem:

  O set da mao principal herda de 'onehanded_shield_swing'. Todas as defend usages que ele
  oferece sao de ESCUDO: as variantes com require_left_hand_usage_root_set="shield" e as com
  ="hand_shield" (act_defend_shield_up_1h_* / act_defend_hand_shield_up_1h_*). Nossa offhand e
  'dual_shield', que herda de 'hand_shield' - entao o jogo defendia com a pose de ESCUDO DE MAO
  segurando uma LAMINA. Nas direcoes left/right/down essa pose deixa a lamina de pe na frente do
  corpo e o capsule cobre o golpe, entao funcionava. Na direcao UP a pose de hand shield levanta o
  antebraco com o escudo DEITADO acima da cabeca - com uma lamina no lugar do escudo nao sobra
  nada atravessando a trajetoria vertical, e o golpe superior passava.

  Correcao: declarar aqui, no set derivado, a defesa up do PARRY DE ARMA do vanilla sem escudo
  (act_defend_up_1h_passive / _active / _parry_light, copiada de 'onehanded_block_swing', com a
  mesma geometria begin_hand_position="0.3,0.25,0.4" begin_hand_rotation="-90,0"). Essa pose poe a
  lamina da MAO PRINCIPAL na horizontal acima da cabeca - a pose que o jogo usa para aparar golpe
  vertical com 1h sem escudo. Fica com require_left_hand_usage_root_set="dual_shield" para valer
  SO com dual wield; sem dual wield o comportamento vanilla continua intacto.

  As tres actions ja existem no vanilla e ja estao ligadas em as_human_warrior
  (defend_up_1h_passive / _active / _parry_light), e ja estao declaradas em action_types do Native.
  Portanto esta correcao NAO precisa de asset novo, action_type novo nem binding novo.

  NAO mexi em defend_down/left/right: o autor confirmou que funcionam. Uma variavel por teste.
-->
<item_usage_sets>
  <item_usage_set id="dual_shield_thrust" base_set="onehanded_shield_swing" has_single_stance="true">
    <usages>
      <usage style="attack_down" ready_action="act_dual_ready_thrust_1h" quick_release_action="act_dual_quick_release_thrust_1h" release_action="act_dual_release_thrust_1h" quick_blocked_action="act_dual_quick_blocked_thrust_1h" blocked_action="act_dual_blocked_thrust_1h" quick_stuck_action="act_stuck_quick_thrust_1h" stuck_action="act_stuck_thrust_1h" is_mounted="False" require_free_left_hand="False" strike_type="thrust" begin_hand_position="0,-0.4,-0.1" begin_hand_rotation="0,-90" begin_arm_rotation="0,0" begin_arm_length="0" end_hand_position="0,1,-0.1" end_hand_rotation="0,-90" end_arm_rotation="0,0" end_arm_length="0" require_left_hand_usage_root_set="dual_shield" />

      <!-- defesa UP: parry de arma do vanilla (onehanded_block_swing), so com dual wield -->
      <usage style="defend_up" defend_action="act_defend_up_1h_passive" defend_active_action="act_defend_up_1h_active" defend_parry_light_action="act_defend_up_1h_parry_light" is_mounted="False" require_free_left_hand="False" begin_hand_position="0.3,0.25,0.4" begin_hand_rotation="-90,0" begin_arm_rotation="0,0" begin_arm_length="0" require_left_hand_usage_root_set="dual_shield" />
      <usage style="defend_up" defend_action="act_defend_up_1h_passive" defend_active_action="act_defend_up_1h_active" defend_parry_light_action="act_defend_up_1h_parry_light" is_mounted="True" require_free_left_hand="False" begin_hand_position="0.3,0.25,0.4" begin_hand_rotation="-90,0" begin_arm_rotation="0,0" begin_arm_length="0" require_left_hand_usage_root_set="dual_shield" />
      <usage style="defend_up" defend_action="act_defend_up_1h_passive_left_stance" defend_active_action="act_defend_up_1h_active_left_stance" defend_parry_light_action="act_defend_up_1h_parry_light_left_stance" is_mounted="False" is_left_stance="True" require_free_left_hand="False" begin_hand_position="0.3,0.25,0.4" begin_hand_rotation="-90,0" begin_arm_rotation="0,0" begin_arm_length="0" require_left_hand_usage_root_set="dual_shield" />
    </usages>
    <guards>
      <guard style="up" action="act_guard_up_1h" hand_position="0,0.1,0.2" hand_rotation="0,0" arm_rotation="0,0" arm_length="0" require_left_hand_usage_root_set="dual_shield" />
      <guard style="up" is_left_stance="True" action="act_guard_up_1h_left_stance" hand_position="0,0.1,0.2" hand_rotation="0,0" arm_rotation="0,0" arm_length="0" require_left_hand_usage_root_set="dual_shield" />
      <guard style="down" action="act_guard_bottom_1h" hand_position="0,0.1,-0.3" hand_rotation="0,-72" arm_rotation="0,0" arm_length="0" require_left_hand_usage_root_set="dual_shield" />
      <guard style="down" is_left_stance="True" action="act_guard_bottom_1h_left_stance" hand_position="0,0.1,-0.3" hand_rotation="0,-72" arm_rotation="0,0" arm_length="0" require_left_hand_usage_root_set="dual_shield" />
      <guard style="left" action="act_guard_left_1h" hand_position="-0.2,0.1,-0.2" hand_rotation="-36,0" arm_rotation="0,0" arm_length="0" require_left_hand_usage_root_set="dual_shield" />
      <guard style="left" is_left_stance="True" action="act_guard_left_1h_left_stance" hand_position="-0.2,0.1,-0.2" hand_rotation="-36,0" arm_rotation="0,0" arm_length="0" require_left_hand_usage_root_set="dual_shield" />
      <guard style="right" action="act_guard_right_1h" hand_position="0.2,0.1,-0.2" hand_rotation="36,0" arm_rotation="0,0" arm_length="0" require_left_hand_usage_root_set="dual_shield" />
      <guard style="right" is_left_stance="True" action="act_guard_right_1h_left_stance" hand_position="0.2,0.1,-0.2" hand_rotation="36,0" arm_rotation="0,0" arm_length="0" require_left_hand_usage_root_set="dual_shield" />
      <guard style="none" hand_position="0,0,-0.5" hand_rotation="0,-90" arm_rotation="0,0" arm_length="0" require_left_hand_usage_root_set="dual_shield" />
      <guard style="none" is_left_stance="True" hand_position="0,0,-0.5" hand_rotation="0,-90" arm_rotation="0,0" arm_length="0" require_left_hand_usage_root_set="dual_shield" />
    </guards>
  </item_usage_set>
  <item_usage_set id="dual_shield" base_set="hand_shield">
    <movement_sets>
      <movement_set id="1h_with_dual_shield" />
    </movement_sets>
  </item_usage_set>
</item_usage_sets>
