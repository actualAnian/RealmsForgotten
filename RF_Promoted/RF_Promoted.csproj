<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Platforms>x64</Platforms>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>RF_Promoted</AssemblyName>
    <RootNamespace>RF_Promoted</RootNamespace>
    <GameFolder>$(BANNERLORD_GAME_DIR)</GameFolder>
    <ModuleRoot>$(GameFolder)\Modules\RealmsForgotten</ModuleRoot>
    <ModuleBin>$(ModuleRoot)\bin\Win64_Shipping_Client</ModuleBin>
    <LocalModuleRoot>..\RealmsForgottenMain\_Module</LocalModuleRoot>
    <LocalModuleBin>$(LocalModuleRoot)\bin\Win64_Shipping_Client</LocalModuleBin>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Optimize>False</Optimize>
    <DebugType>portable</DebugType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Optimize>False</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(GameFolder)\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\Native\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\SandBoxCore\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\CustomBattle\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\SandBox\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="$(GameFolder)\Modules\StoryMode\bin\Win64_Shipping_Client\*.dll">
      <HintPath>%(Identity)</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="promoted_config.txt" />
    <None Include="_Module\ModuleData\promoted_strings.xml" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build">
    <MakeDir Directories="$(LocalModuleBin)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(LocalModuleBin)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(LocalModuleBin)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="promoted_config.txt"
          DestinationFolder="$(LocalModuleRoot)"
          SkipUnchangedFiles="true" />
    <MakeDir Directories="$(LocalModuleRoot)\ModuleData" />
    <Copy SourceFiles="_Module\ModuleData\promoted_strings.xml"
          DestinationFolder="$(LocalModuleRoot)\ModuleData"
          SkipUnchangedFiles="true" />

    <MakeDir Directories="$(ModuleBin)" Condition="'$(GameFolder)' != ''" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(ModuleBin)"
          SkipUnchangedFiles="true"
          Condition="'$(GameFolder)' != ''" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(ModuleBin)"
          SkipUnchangedFiles="true"
          Condition="'$(GameFolder)' != '' and Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="promoted_config.txt"
          DestinationFolder="$(ModuleRoot)"
          SkipUnchangedFiles="true"
          Condition="'$(GameFolder)' != ''" />
    <MakeDir Directories="$(ModuleRoot)\ModuleData" Condition="'$(GameFolder)' != ''" />
    <Copy SourceFiles="_Module\ModuleData\promoted_strings.xml"
          DestinationFolder="$(ModuleRoot)\ModuleData"
          SkipUnchangedFiles="true"
          Condition="'$(GameFolder)' != ''" />
  </Target>

</Project>
